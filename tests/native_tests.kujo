test_setup { from src.xai import create_client, client_chat, parse_stream }
test "client validates host and bearer auth" { c:=create_client({"api_key":"secret","transport":func(url,o) { assert_equal(o["_headers"]["Authorization"],"Bearer secret"); return Ok({"_status":200,"_body":"{\"choices\":[]}"}) }}); assert_true(client_chat(c,{"model":"grok-test","reasoning_effort":"high"})["ok"]); assert_true(create_client({"base_url":"http://remote.example"})["validation_error"]!="") }
test "stream parser and redaction" { p:=parse_stream(["data: {\"choices\":[{\"delta\":{\"content\":\"A\"}}]}\n\n","data: [DONE]\n\n"],""); assert_true(p["ok"]); assert_equal(len(p["events"]),1); c:=create_client({"api_key":"secret","transport":func(url,o) { return Ok({"_status":401,"_body":"{\"error\":{\"message\":\"secret denied\"}}"}) }}); r:=client_chat(c,{}); assert_equal(contains(r["message"],"secret"),0) }
