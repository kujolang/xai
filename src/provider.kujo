func get(o,k,f) { if type(o)=="dict" && has_key(o,k) { return o[k] }; return f }
func provider_impl(config) { if type(config)!="dict" { config:={} }; return {"name":"xai","base_url":get(config,"base_url","https://api.x.ai/v1"),"default_model":get(config,"model",""),"api_key_env":"XAI_API_KEY","capabilities":{"streaming":true,"tool_calls":true,"structured_output":true,"vision":true,"reasoning":true},"driver":driver()} }
func describe(p) { return {"id":"xai-compatible","protocol":"xai-openai-compatible","auth":{"mode":"bearer","allow_anonymous":false},"capabilities":p["capabilities"]} }
func validate(p) { if type(p)!="dict" || get(p,"base_url","")=="" { return {"ok":false,"errors":[{"field":"base_url","message":"xAI provider requires a base URL."}]}}; return {"ok":true,"errors":[]} }
func encode_chat(ctx) { o:=ctx["resolved_options"]; msgs:=[]; for m in ctx["messages"] { msgs=push(msgs,{"role":get(m,"role","user"),"content":get(m,"content","")}) }; body:={"model":get(o,"model",get(ctx["provider"],"default_model","")),"messages":msgs,"stream":get(o,"stream",false)}; for k in ["tools","tool_choice","response_format","temperature","top_p","max_tokens","reasoning","provider"] { if has_key(o,k) { body[k]:=o[k] } }; return {"url":ctx["provider"]["base_url"]+"/chat/completions","method":"POST","headers":{"Authorization":"Bearer "+ctx["credential"],"Content-Type":"application/json"},"protected_headers":["Authorization","Content-Type"],"body":to_json(body),"stream_mode":get(o,"stream",false)} }
func decode_chat(ctx) { d:=ctx["data"]; c:={}; if len(get(d,"choices",[]))>0 { c:=d["choices"][0] }; m:=get(c,"message",{}); u:=get(d,"usage",{}); return {"ok":true,"request_id":get(ctx,"request_id",""),"model":get(d,"model",get(ctx,"fallback_model","")),"output_text":get(m,"content",""),"finish_reason":get(c,"finish_reason","stop"),"tool_calls":get(m,"tool_calls",[]),"usage":{"input_tokens":get(u,"prompt_tokens",0),"output_tokens":get(u,"completion_tokens",0),"total_tokens":get(u,"total_tokens",0)},"raw_provider":d} }
func decode_error(ctx) { d:=ctx["data"]; if type(d)!="dict" || !has_key(d,"error") { return {"ok":false,"matched":false} }; e:=d["error"]; return {"ok":false,"matched":true,"category":"provider","message":get(e,"message","xAI request failed"),"provider_code":get(e,"code","xai_error"),"raw_provider":d} }
func decode_stream(ctx) { p:=parse_stream(get(ctx,"chunks",[]),get(ctx,"body_text","")); if !p["ok"] { return p }; text:=""; for e in p["events"] { c:={}; if len(get(e,"choices",[]))>0 { c:=e["choices"][0] }; text:=text+get(get(c,"delta",{}),"content","") }; return {"ok":true,"output_text":text,"finish_reason":"stop","usage":{"input_tokens":0,"output_tokens":0,"total_tokens":0},"raw_provider":{"stream_events":p["events"]}} }
func driver() { return {"contract":"ai-sdk-provider-driver","version":"1.0.0","id":"xai-compatible","describe":describe,"validate":validate,"encode_chat":encode_chat,"decode_chat":decode_chat,"decode_error":decode_error,"decode_stream":decode_stream} }
export xai_provider:=provider_impl
export xai_driver:=driver
